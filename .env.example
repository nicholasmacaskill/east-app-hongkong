# .env.example (Safe to commit)

# Database
DB_HOST=localhost
DB_PORT=54322
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# App Config
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder_key

# Stripe (Public keys are technically safe, but secrets MUST be hidden)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Price IDs (These are generally safe to commit, but placeholders are fine too)
NEXT_PUBLIC_STRIPE_PRICE_GYM=price_placeholder
NEXT_PUBLIC_STRIPE_PRICE_ALL=price_placeholder
NEXT_PUBLIC_STRIPE_PRICE_ELITE=price_placeholder

# Email
RESEND_API_KEY=re_placeholder
NEXT_PUBLIC_USE_MOCK_DATA=false